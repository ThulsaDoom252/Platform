# Скопируй этот файл в .env и заполни значения.
# Сам .env в репозиторий не попадает — без него платформа запустится,
# но в ней не будет ни учителя, ни учеников.

# ---------- База данных ----------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/english_with_vlad"

# ---------- Сессии ----------
# Обязательно. Длинная случайная строка — ею подписываются JWT-токены входа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# ---------- Админка (учитель) ----------
# Из этих значений сид создаёт аккаунт учителя.
TEACHER_NAME=""
TEACHER_LOGIN=""
TEACHER_PASSWORD=""

# ---------- Ученики ----------
# Стандартный пароль, который получает каждый ученик при создании через сид.
STUDENT_DEFAULT_PASSWORD=""

# ---------- Быстрый перевод материалов через DeepL ----------
# Создать ключ: https://www.deepl.com/en/developers
# Ключ хранится только на сервере и никогда не отправляется в браузер.
DEEPL_AUTH_KEY=""
# Также поддерживается имя DEEPL_KEY.
# Обычно оставьте пустым. Можно задать свой совместимый endpoint DeepL.
DEEPL_API_URL=""

# ---------- AI: иконки и структура со скриншота (необязательно) ----------
# Хватит любого одного; если заданы оба, берётся Anthropic.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---------- Точный импорт вкладок Google Docs (необязательно) ----------
# Публичный OAuth Client ID типа «Web application». Секрет и API key не нужны.
# В Google Cloud включи Docs API и добавь http://localhost:3000 в
# Authorized JavaScript origins. Для онлайна добавь туда адрес платформы.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
