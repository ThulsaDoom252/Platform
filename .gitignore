# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...но шаблон без значений нужен в репозитории
!.env.example

# загруженные пользователями файлы (аватары и т.п.)
/public/uploads

# архив исходников, оставшийся от переноса проекта
*.tar.gz

# копии базы, снятые npm run db:backup
/backups

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
